SafeCall("AutoFarm", function()
    local Enabled, Selected, List = false, nil, {}
    local function GetDataPaths()
        local Data = ReplicatedStorage:FindFirstChild("Data")
        local Assets = Data and Data:FindFirstChild("Assets")
        local Configs = Assets and Assets:FindFirstChild("Configs")
        local EggModels = nil
        local RAS = ReplicatedStorage:FindFirstChild("Assets")
        if RAS then
            local M = RAS:FindFirstChild("Models")
            if M then EggModels = M:FindFirstChild("Eggs") end
        end
        if not EggModels and Assets then
            local M = Assets:FindFirstChild("Models")
            if M then EggModels = M:FindFirstChild("Eggs") end
        end
        return Data, Assets, Configs, EggModels
    end
    local MeshMap = {}
    local function BuildMeshMap()
        MeshMap = {}
        local _, _, Configs, EggModels = GetDataPaths()
        if not Configs or not EggModels then return end
        for _, C in ipairs(Configs:GetChildren()) do
            local ok, M = pcall(function() return require(C) end)
            if ok and M and M.Egg then
                local MN = M.Egg.ModelName or C.Name
                local Template = EggModels:FindFirstChild(MN)
                if Template then
                    for _, d in ipairs(Template:GetDescendants()) do
                        if d:IsA("MeshPart") and d.MeshId ~= "" then MeshMap[d.MeshId] = C.Name end
                        if d:IsA("SpecialMesh") and d.MeshId ~= "" then MeshMap[d.MeshId] = C.Name end
                    end
                end
            end
        end
    end
    BuildMeshMap()
    local function GetData(Cat)
        local _, _, Configs = GetDataPaths()
        if not Configs then return nil end
        local C = Configs:FindFirstChild(Cat) if not C then return nil end
        local D = {Name = Cat, DisplayName = Cat, EarningRate = 0, Icon = nil}
        local ok, M = pcall(function() return require(C) end)
        if ok and M then
            D.DisplayName = M.DisplayName or Cat
            D.EarningRate = M.EarningRate or 0
            D.Icon = M.Icon
        end
        return D
    end
    local function FM(A)
        if type(A) ~= "number" then return tostring(A) end
        if A >= 1e12 then return string.format("%.2fT", A/1e12)
        elseif A >= 1e9 then return string.format("%.2fB", A/1e9)
        elseif A >= 1e6 then return string.format("%.2fM", A/1e6)
        elseif A >= 1e3 then return string.format("%.2fK", A/1e3)
        else return tostring(math.floor(A)) end
    end
    local function MatchCategory(model)
        if not next(MeshMap) then BuildMeshMap() end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("MeshPart") and d.MeshId ~= "" and MeshMap[d.MeshId] then return MeshMap[d.MeshId] end
            if d:IsA("SpecialMesh") and d.MeshId ~= "" and MeshMap[d.MeshId] then return MeshMap[d.MeshId] end
        end
        return nil
    end
    local function Scan()
        List = {}
        local Container = workspace:FindFirstChild("AreaEggSlotsClient")
        if not Container then return List end
        for _, c in ipairs(Container:GetChildren()) do
            if c:IsA("Model") then
                local cat = MatchCategory(c)
                if cat then
                    local D = GetData(cat)
                    table.insert(List, {
                        Id = c.Name, Category = cat,
                        DisplayName = (D and D.DisplayName) or cat,
                        Icon = D and D.Icon or nil,
                        EarningRate = (D and D.EarningRate) or 0,
                        Model = c,
                    })
                end
            end
        end
        table.sort(List, function(a,b) return a.EarningRate > b.EarningRate end)
        print("[BY THZIN] Scan → Mostrados: " .. #List)
        return List
    end
    _G.YOKUDO_AutoFarm = {
        Enable = function() Enabled = true end,
        Disable = function() Enabled = false end,
        IsEnabled = function() return Enabled end,
        ScanEggs = Scan,
        GetEggList = function() return List end,
        SelectEgg = function(E) Selected = E end,
        StartTeleport = function()
            if not Selected then warn("[BY THZIN] Nenhum ovo selecionado") return end
            local M = _G.YOKUDO_SelectedMethod or "TeleportFly"
            local S = _G.YOKUDO_TeleportSpeed or 500
            if _G.YOKUDO_TeleportSystem then
                _G.YOKUDO_TeleportSystem.SetMethod(M)
                _G.YOKUDO_TeleportSystem.SetSpeed(S)
                _G.YOKUDO_TeleportSystem.SetTargetId(Selected.Id)
                _G.YOKUDO_TeleportSystem.Enable()
            end
        end,
        StopTeleport = function()
            if _G.YOKUDO_TeleportSystem then _G.YOKUDO_TeleportSystem.Disable() end
        end,
        GetSelectedEgg = function() return Selected end,
        FormatMoney = FM,
    }
end)

