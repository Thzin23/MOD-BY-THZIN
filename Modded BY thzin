SafeCall("AFKSystem", function()
    local SPEED = 400
    local SAFE = Vector3.new(533,70,-366)
    local Enabled, Plot, TMd, TMPos = false, nil, nil, nil
    local FlyC, BV, BG, Thread = nil, nil, nil, nil
    local function GetHum()
        local C = Player.Character if not C then return nil, nil end
        return C:FindFirstChildOfClass("Humanoid"), C:FindFirstChild("HumanoidRootPart")
    end
    local function Cleanup()
        if FlyC then FlyC:Disconnect() FlyC = nil end
        if BV then pcall(function() BV:Destroy() end) BV = nil end
        if BG then pcall(function() BG:Destroy() end) BG = nil end
        local H, R = GetHum()
        if R then
            for _, c in ipairs(R:GetChildren()) do
                if c.Name == "YokudoBV" or c.Name == "YokudoBG" then c:Destroy() end
            end
        end
        if H then pcall(function() H.PlatformStand = false H.Sit = false end) end
    end
    local function FindPlot()
        local P = workspace:FindFirstChild("Plots") if not P then return end
        for _, plot in ipairs(P:GetChildren()) do
            if plot:IsA("Model") then
                local S = plot:FindFirstChild("PlotSign")
                if S then
                    local PS = S:FindFirstChild("PlayerPlotSign")
                    if PS then
                        local F = PS:FindFirstChild("Frame")
                        if F then
                            local N = F:FindFirstChild("PlayerName")
                            if N and N:IsA("TextLabel") and (N.Text == Player.Name or N.Text == Player.DisplayName) then
                                return plot, plot:FindFirstChild("TreadmillBottom")
                            end
                        end
                    end
                end
            end
        end
    end
    local function FlyTP(Dest, Cb)
        Cleanup()
        local H, R = GetHum() if not H or not R then if Cb then Cb() end return end
        H.PlatformStand = true
        BV = Instance.new("BodyVelocity") BV.Name = "YokudoBV"
        BV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        BV.P = 1250 BV.Velocity = Vector3.zero BV.Parent = R
        BG = Instance.new("BodyGyro") BG.Name = "YokudoBG"
        BG.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
        BG.P = 3000 BG.D = 500 BG.CFrame = R.CFrame BG.Parent = R
        local Start = tick()
        FlyC = RunService.Heartbeat:Connect(function()
            if not Enabled then Cleanup() return end
            local H2, R2 = GetHum() if not H2 or not R2 or H2.Health <= 0 then Cleanup() return end
            if not BV or not BG then Cleanup() return end
            local D = Dest - R2.Position
            if D.Magnitude <= 2 then
                Cleanup() R2.CFrame = CFrame.new(Dest)
                R2.AssemblyLinearVelocity = Vector3.zero R2.AssemblyAngularVelocity = Vector3.zero
                if Cb then Cb() end return
            end
            if tick()-Start > 15 then Cleanup() if Cb then Cb() end return end
            BV.Velocity = D.Unit * SPEED
            BG.CFrame = CFrame.new(R2.Position, Dest)
        end)
    end
    _G.YOKUDO_AFKSystem = {
        Enable = function()
            if Enabled then return end
            Enabled = true
            Plot, TMd = FindPlot()
            if not TMd then Enabled = false return end
            TMPos = TMd.Position
            FlyTP(TMPos, function()
                Thread = task.spawn(function()
                    while Enabled do
                        task.wait(4)
                        if not Enabled then break end
                        local _, R = GetHum()
                        if R and TMPos then
                            local D = math.floor((R.Position - TMPos).Magnitude)
                            if D > 5 then FlyTP(TMPos) end
                        end
                    end
                end)
            end)
        end,
        Disable = function()
            if not Enabled then return end
            Enabled = false
            if Thread then pcall(function() task.cancel(Thread) end) Thread = nil end
            Cleanup()
            ResetCharacterState()
        end,
        IsEnabled = function() return Enabled end,
        FlyTP = FlyTP,
        FindMyPlotAndTreadmill = FindPlot,
        GetMyTreadmillPos = function() return TMPos end,
    }
end)

