SafeCall("ConfigSystem", function()
    local FOLDER = "YOKUDO-SAE"
    local FILE = FOLDER .. "/yokudo.json"
    local DEF = {SelectedMethod = "TeleportFly", TeleportSpeed = 300}
    local function Ensure()
        pcall(function() if not isfolder(FOLDER) then makefolder(FOLDER) end end)
    end
    local function Load()
        Ensure()
        local C = table.clone(DEF)
        if not pcall(function() return isfile(FILE) end) then return C end
        local ok, raw = pcall(function() return readfile(FILE) end)
        if not ok or not raw or raw == "" then return C end
        local ok2, D = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok2 or type(D) ~= "table" then return C end
        if type(D.SelectedMethod) == "string" and (D.SelectedMethod == "TeleportFly" or D.SelectedMethod == "InstantTeleport") then
            C.SelectedMethod = D.SelectedMethod
        end
        if type(D.TeleportSpeed) == "number" then
            C.TeleportSpeed = math.clamp(D.TeleportSpeed, 50, 1100)
        end
        return C
    end
    local function Save(C)
        Ensure()
        local d = {SelectedMethod = C.SelectedMethod or DEF.SelectedMethod, TeleportSpeed = C.TeleportSpeed or DEF.TeleportSpeed}
        local ok, e = pcall(function() return HttpService:JSONEncode(d) end)
        if not ok then return false end
        pcall(function() writefile(FILE, e) end)
        return true
    end
    local function Apply(C)
        _G.YOKUDO_SelectedMethod = C.SelectedMethod
        _G.YOKUDO_TeleportSpeed = C.TeleportSpeed
    end
    Apply(Load())
    _G.YOKUDO_ConfigSystem = {
        Folder = FOLDER, File = FILE, Default = DEF,
        Load = function() local C = Load() Apply(C) return C end,
        Save = function() return Save({SelectedMethod = _G.YOKUDO_SelectedMethod or DEF.SelectedMethod, TeleportSpeed = _G.YOKUDO_TeleportSpeed or DEF.TeleportSpeed}) end,
        Get = function() return {SelectedMethod = _G.YOKUDO_SelectedMethod or DEF.SelectedMethod, TeleportSpeed = _G.YOKUDO_TeleportSpeed or DEF.TeleportSpeed} end,
        Reset = function() Apply(DEF) return Save(DEF) end,
    }
end)

