SafeCall("Bypass", function()
    local function Run()
        local C = Player.Character if not C then return end
        local Old = C:FindFirstChildOfClass("Humanoid") if not Old then return end
        local New = Old:Clone() New.Name = Old.Name
        for _, Ch in ipairs(Old:GetChildren()) do
            local Ex = New:FindFirstChild(Ch.Name)
            if Ex then pcall(function() Ex:Destroy() end) end
            pcall(function() Ch.Parent = New end)
        end
        Old:Destroy() task.wait() New.Parent = C task.wait()
        if not New.Parent then return end
        pcall(function()
            New:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            New.BreakJointsOnDeath = false New.RequiresNeck = false
        end)
        local Ani = New:FindFirstChildOfClass("Animator")
        if not Ani then Ani = Instance.new("Animator") Ani.Parent = New end
        pcall(function()
            local PS = Player:FindFirstChild("PlayerScripts")
            if not PS then return end
            local PM = PS:FindFirstChild("PlayerModule")
            if not PM then return end
            local ok, M = pcall(function() return require(PM) end)
            if not ok or not M then return end
            local Ctrl pcall(function() Ctrl = M:GetControls() end)
            if not Ctrl then return end
            pcall(function() Ctrl:OnCharacterAdded(C) end)
            task.wait()
            pcall(function() Ctrl:UpdateActiveControlModuleEnabled() end)
        end)
        pcall(function()
            local Cam = workspace.CurrentCamera
            if Cam then Cam.CameraSubject = New end
        end)
        local Animate = C:FindFirstChild("Animate")
        if Animate then
            pcall(function() Animate.Disabled = true task.wait(0.05) Animate.Disabled = false end)
        end
    end
    Player.CharacterAdded:Connect(function() task.wait(1.5) Run() end)
end)

