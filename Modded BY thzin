local function Log(m) print("[BY THZIN] " .. m) end
local function SafeCall(name, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[BY THZIN] ❌ " .. name .. ": " .. tostring(err)) else Log("✅ " .. name) end
    return ok
end
local function AddRipple(btn, color)
    color = color or T.Primary
    local r = Instance.new("Frame")
    r.Name = "Ripple" r.BackgroundColor3 = color r.BackgroundTransparency = 0.6
    r.BorderSizePixel = 0 r.Size = UDim2.new(0,0,0,0) r.AnchorPoint = Vector2.new(0.5,0.5)
    r.ZIndex = btn.ZIndex + 1 r.Parent = btn
    Instance.new("UICorner", r).CornerRadius = UDim.new(1,0)
    btn.MouseButton1Down:Connect(function()
        local mx, my = UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y
        local ax, ay = btn.AbsolutePosition.X, btn.AbsolutePosition.Y
        local sz = btn.AbsoluteSize
        r.Position = UDim2.new(0, mx-ax, 0, my-ay)
        r.Size = UDim2.new(0,0,0,0) r.BackgroundTransparency = 0.6
        local maxD = math.max(sz.X, sz.Y) * 2.5
        TweenService:Create(r, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0,maxD,0,maxD), BackgroundTransparency = 1
        }):Play()
        task.delay(0.5, function()
            if r and r.Parent then r.Size = UDim2.new(0,0,0,0) r.BackgroundTransparency = 0.6 end
        end)
    end)
end

