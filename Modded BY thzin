SafeCall("AutoAttack", function()
    local Backpack = Player:WaitForChild("Backpack", 10)
    local RANGE, INTERVAL = 60, 0.01
    local AutoEq, AutoHit, EqConn, HitConn, LastFire, Seq = false, false, nil, nil, 0, 0
    local function GetHum()
        local C = Player.Character if not C then return nil, nil end
        return C:FindFirstChildOfClass("Humanoid"), C:FindFirstChild("HumanoidRootPart")
    end
    local function GetRemote()
        local ok, R = pcall(function() return ReplicatedStorage.Packages.Networking["RE/BatSwing/Trigger"] end)
        if ok then return R end
    end
    local function FindBat()
        if Backpack then
            for _, t in ipairs(Backpack:GetChildren()) do
                if t:IsA("Tool") and (t.ToolTip == "Bat" or t.Name:find("Bat")) then return t end
            end
        end
        local C = Player.Character
        if C then
            for _, t in ipairs(C:GetChildren()) do
                if t:IsA("Tool") and (t.ToolTip == "Bat" or t.Name:find("Bat")) then return t end
            end
        end
    end
    local function EquipBat()
        local B = FindBat() if not B then return end
        if B.Parent == Backpack then
            local H = GetHum() if H then H:EquipTool(B) end
        end
    end
    local function FindClose()
        local _, R = GetHum() if not R then return nil end
        local Best, BD = nil, RANGE
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Player then
                local C = p.Character
                if C then
                    local H = C:FindFirstChildOfClass("Humanoid")
                    local R2 = C:FindFirstChild("HumanoidRootPart")
                    if H and R2 and H.Health > 0 then
                        local D = (R2.Position - R.Position).Magnitude
                        if D < BD then BD = D Best = p end
                    end
                end
            end
        end
        return Best
    end
    local function Fire()
        local T2 = FindClose() if not T2 then return end
        local Rem = GetRemote() if not Rem then return end
        Seq = Seq + 1
        local ID = tostring(Player.UserId)..":"..tostring(Seq)..":"..tostring(math.floor(workspace:GetServerTimeNow()*1000))
        pcall(function() Rem:FireServer(T2, ID) end)
    end
    _G.YOKUDO_AutoAttack = {
        ToggleAutoEquip = function()
            AutoEq = not AutoEq
            if AutoEq then
                EquipBat()
                if EqConn then EqConn:Disconnect() end
                EqConn = RunService.Heartbeat:Connect(function()
                    if not AutoEq then return end
                    local B = FindBat()
                    if B and B.Parent == Backpack then EquipBat() end
                end)
            else
                if EqConn then EqConn:Disconnect() EqConn = nil end
            end
        end,
        EnableAutoEquip = function() if not AutoEq then _G.YOKUDO_AutoAttack.ToggleAutoEquip() end end,
        DisableAutoEquip = function() if AutoEq then _G.YOKUDO_AutoAttack.ToggleAutoEquip() end end,
        IsAutoEquipEnabled = function() return AutoEq end,
        ToggleAutoHit = function()
            AutoHit = not AutoHit
            if AutoHit then
                if HitConn then HitConn:Disconnect() end
                HitConn = RunService.Heartbeat:Connect(function()
                    if not AutoHit then return end
                    local n = tick()
                    if n - LastFire < INTERVAL then return end
                    LastFire = n Fire()
                end)
            else
                if HitConn then HitConn:Disconnect() HitConn = nil end
            end
        end,
        EnableAutoHit = function() if not AutoHit then _G.YOKUDO_AutoAttack.ToggleAutoHit() end end,
        DisableAutoHit = function() if AutoHit then _G.YOKUDO_AutoAttack.ToggleAutoHit() end end,
        IsAutoHitEnabled = function() return AutoHit end,
        FindBatTool = FindBat,
        GetBatSwingRemote = GetRemote,
    }
end)

