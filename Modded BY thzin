local SavedStats = {
    Humanoid = nil,
    WalkSpeed = nil,
    JumpPower = nil,
    JumpHeight = nil,
    UseJumpPower = nil,
}

local function SaveStatsIfNeeded()
    local C = Player.Character
    if not C then return end
    local H = C:FindFirstChildOfClass("Humanoid")
    if not H then return end
    if SavedStats.Humanoid == H and SavedStats.WalkSpeed then return end
    SavedStats.Humanoid = H
    SavedStats.WalkSpeed = H.WalkSpeed
    SavedStats.JumpPower = H.JumpPower
    SavedStats.JumpHeight = H.JumpHeight
    SavedStats.UseJumpPower = H.UseJumpPower
    print("[BY THZIN] Stats salvos | WalkSpeed: " .. tostring(H.WalkSpeed) .. " | JumpPower: " .. tostring(H.JumpPower))
end

local function RestoreSavedState()
    local C = Player.Character
    if not C then return end
    local H = C:FindFirstChildOfClass("Humanoid")
    if not H then return end
    pcall(function()
        H.PlatformStand = false
        H.Sit = false
        H.AutoRotate = true
        if SavedStats.Humanoid == H then
            if SavedStats.WalkSpeed then H.WalkSpeed = SavedStats.WalkSpeed end
            if SavedStats.JumpPower then H.JumpPower = SavedStats.JumpPower end
            if SavedStats.JumpHeight then H.JumpHeight = SavedStats.JumpHeight end
            if SavedStats.UseJumpPower ~= nil then H.UseJumpPower = SavedStats.UseJumpPower end
        end
    end)
    pcall(function()
        H:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        H:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        H:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        H:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        H:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        H:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        H:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    end)
    local R = C:FindFirstChild("HumanoidRootPart")
    if R then
        pcall(function()
            R.AssemblyLinearVelocity = Vector3.zero
            R.AssemblyAngularVelocity = Vector3.zero
        end)
        for _, c in ipairs(R:GetChildren()) do
            if c.Name == "YokudoBV" or c.Name == "YokudoBG" then
                pcall(function() c:Destroy() end)
            end
        end
    end
    local Animate = C:FindFirstChild("Animate")
    if Animate then
        task.spawn(function()
            pcall(function()
                Animate.Disabled = true
                task.wait(0.1)
                Animate.Disabled = false
            end)
        end)
    end
    pcall(function()
        local PS = Player:FindFirstChild("PlayerScripts")
        if not PS then return end
        local PM = PS:FindFirstChild("PlayerModule")
        if not PM then return end
        local ok, M = pcall(function() return require(PM) end)
        if not ok or not M then return end
        local Ctrl
        pcall(function() Ctrl = M:GetControls() end)
        if not Ctrl then return end
        pcall(function() Ctrl:OnCharacterAdded(C) end)
        pcall(function() Ctrl:UpdateActiveControlModuleEnabled() end)
    end)
end

local function ResetCharacterState()
    RestoreSavedState()
end

task.spawn(function()
    task.wait(3)
    SaveStatsIfNeeded()
end)
Player.CharacterAdded:Connect(function()
    SavedStats.Humanoid = nil
    task.wait(3)
    SaveStatsIfNeeded()
end)

