SafeCall("TeleportSystem", function()
    local Container = workspace:FindFirstChild("AreaEggSlotsClient") or workspace:WaitForChild("AreaEggSlotsClient", 15)
    local CollectEvent, ForestStrike
    pcall(function() CollectEvent = ReplicatedStorage.Packages.Networking["RF/EggWorld/AskFieldEggCarry"] end)
    pcall(function() ForestStrike = ReplicatedStorage.Packages.Networking["RE/GuardPatrol/ForestStrike"] end)
    local TARGET_UID, SPEED, METHOD = nil, 300, "TeleportFly"
    local SAFE_ZONE = Vector3.new(533,70,-366)
    local Running = false
    local C1, C2, BV, BG = nil, nil, nil, nil
    local FirstList, FirstUid, FirstKey = {}, nil, nil
    local CollectDone, TgtDone = false, false
    local SavedTarget = nil
    local function GetHum()
        local C = Player.Character if not C then return nil, nil end
        return C:FindFirstChildOfClass("Humanoid"), C:FindFirstChild("HumanoidRootPart")
    end
    local function Cleanup()
        if C1 then C1:Disconnect() C1 = nil end
        if C2 then C2:Disconnect() C2 = nil end
        if BV then pcall(function() BV:Destroy() end) BV = nil end
        if BG then pcall(function() BG:Destroy() end) BG = nil end
        local H, R = GetHum()
        if R then
            for _, c in ipairs(R:GetChildren()) do
                if c.Name == "YokudoBV" or c.Name == "YokudoBG" then pcall(function() c:Destroy() end) end
            end
        end
        if H then pcall(function() H.PlatformStand = false H.Sit = false end) end
        if R then pcall(function()
            R.AssemblyLinearVelocity = Vector3.zero
            R.AssemblyAngularVelocity = Vector3.zero
        end) end
    end
    local function GetPos(O)
        if not O then return nil end
        if O:IsA("Model") then
            if O.PrimaryPart then return O.PrimaryPart.Position end
            local P = O:FindFirstChildWhichIsA("BasePart")
            if P then return P.Position end
            for _, d in ipairs(O:GetDescendants()) do
                if d:IsA("BasePart") then return d.Position end
            end
        elseif O:IsA("BasePart") then return O.Position end
    end
    local function Lock(P, L)
        local LC = CFrame.new(P, L or (P + Vector3.new(0,0,-1)))
        if C2 then C2:Disconnect() end
        C2 = RunService.Heartbeat:Connect(function()
            if not Running then if C2 then C2:Disconnect() C2 = nil end return end
            local _, R = GetHum() if not R then return end
            R.CFrame = LC
            R.AssemblyLinearVelocity = Vector3.zero
            R.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    local function FlyTP(Dest, Sp, Shot, Safe, Cb)
        Cleanup()
        local H, R = GetHum()
        if not H or not R or H.Health <= 0 then if Cb then Cb() end return end
        local Fly = Vector3.new(Dest.X, Dest.Y+25, Dest.Z)
        local LC = CFrame.new(Dest + Vector3.new(0,2,0))
        H.PlatformStand = true
        BV = Instance.new("BodyVelocity") BV.Name = "YokudoBV"
        BV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        BV.P = 1250 BV.Velocity = Vector3.zero BV.Parent = R
        BG = Instance.new("BodyGyro") BG.Name = "YokudoBG"
        BG.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
        BG.P = 3000 BG.D = 500 BG.CFrame = R.CFrame BG.Parent = R
        local Start, ShotDone = tick(), false
        C1 = RunService.Heartbeat:Connect(function()
            if not Running then Cleanup() return end
            local H2, R2 = GetHum()
            if not H2 or not R2 or H2.Health <= 0 then Cleanup() return end
            if not BV or not BG then Cleanup() return end
            local P = R2.Position
            local D = Fly - P
            local HD = Vector3.new(D.X,0,D.Z).Magnitude
            local VD = math.abs(D.Y)
            if Safe and HD <= 3 then
                Cleanup() R2.CFrame = LC
                R2.AssemblyLinearVelocity = Vector3.zero R2.AssemblyAngularVelocity = Vector3.zero
                Lock(Dest) if Cb then Cb() end return
            end
            if not Safe and Shot and not ShotDone and HD <= 30 then
                ShotDone = true Cleanup() R2.CFrame = LC
                R2.AssemblyLinearVelocity = Vector3.zero R2.AssemblyAngularVelocity = Vector3.zero
                Lock(Dest) if Cb then Cb() end return
            end
            if HD <= 2 and VD <= 2 then
                Cleanup() R2.CFrame = LC
                R2.AssemblyLinearVelocity = Vector3.zero R2.AssemblyAngularVelocity = Vector3.zero
                Lock(Dest) if Cb then Cb() end return
            end
            if tick()-Start > 30 then Cleanup() if Cb then Cb() end return end
            if D.Magnitude > 1 then BV.Velocity = D.Unit * Sp else BV.Velocity = Vector3.zero end
            BG.CFrame = CFrame.new(P, P + Vector3.new(D.X,0,D.Z))
        end)
    end
    local function InstantTP(Dest, Cb)
        Cleanup()
        local H, R = GetHum()
        if not H or not R or H.Health <= 0 then if Cb then Cb() end return end
        R.CFrame = CFrame.new(Dest + Vector3.new(0,2,0))
        R.AssemblyLinearVelocity = Vector3.zero R.AssemblyAngularVelocity = Vector3.zero
        Lock(Dest) if Cb then Cb() end
    end
    local function SearchFirst()
        FirstList = {}
        if not Container then return end
        for _, s in ipairs(Container:GetChildren()) do
            if string.find(s.Name, "FirstAreaEgg") then
                local N = string.match(s.Name, "Slot_(%d+)")
                if N then table.insert(FirstList, {Slot = s, Uid = s.Name, Key = "Forest:Slot_" .. N}) end
            end
        end
    end
    local function FindClosest()
        local _, R = GetHum() if not R then return end
        local B, BD = nil, 99999
        for _, E in ipairs(FirstList) do
            local P = GetPos(E.Slot)
            if P then
                local D = (P - R.Position).Magnitude
                if D < BD then BD = D B = E end
            end
        end
        if B then FirstUid = B.Uid FirstKey = B.Key end
        return B
    end
    local function AutoStop() Running = false Cleanup() end
    local function StartProc()
        Running = true
        CollectDone, TgtDone = false, false
        SavedTarget = nil
        local Mode = "spawn"
        if Container and Container:FindFirstChild(TARGET_UID) then Mode = "spawn"
        elseif workspace:FindFirstChild(TARGET_UID) then
            Mode = "workspace"
            SavedTarget = GetPos(workspace:FindFirstChild(TARGET_UID))
        else AutoStop() return end
        SearchFirst()
        if #FirstList == 0 then AutoStop() return end
        local C = FindClosest() if not C then AutoStop() return end
        local P = GetPos(C.Slot) if not P then AutoStop() return end
        FlyTP(P, SPEED, true, false, function()
            task.spawn(function()
                local tries = 0
                while Running and not CollectDone and tries < 50 do
                    task.wait(0.2) tries = tries + 1
                    if CollectEvent and FirstKey and FirstUid then
                        pcall(function() CollectEvent:InvokeServer({FirstAreaSlotKey = FirstKey, Uid = FirstUid}) end)
                    end
                    if FirstUid and workspace:FindFirstChild(FirstUid) then CollectDone = true end
                end
                task.wait(2)
                if not Running then return end
                local TP = nil
                if Mode == "spawn" then
                    local E = Container and Container:FindFirstChild(TARGET_UID)
                    if E then TP = GetPos(E) end
                else TP = SavedTarget end
                if not TP then AutoStop() return end
                local Fn = (METHOD == "InstantTeleport") and InstantTP or function(P2, Cb) FlyTP(P2, SPEED, true, false, Cb) end
                Fn(TP, function()
                    task.spawn(function()
                        local t2 = 0
                        while Running and not TgtDone and t2 < 50 do
                            task.wait(0.2) t2 = t2 + 1
                            if CollectEvent then pcall(function() CollectEvent:InvokeServer({Uid = TARGET_UID}) end) end
                            if Mode == "spawn" and workspace:FindFirstChild(TARGET_UID) then TgtDone = true
                            elseif Mode == "workspace" and SavedTarget then
                                local W = workspace:FindFirstChild(TARGET_UID)
                                if W then
                                    local NP = GetPos(W)
                                    if NP and (NP - SavedTarget).Magnitude >= 1 then TgtDone = true end
                                end
                            end
                        end
                        if not Running then return end
                        FlyTP(SAFE_ZONE, SPEED, false, true, function() AutoStop() end)
                    end)
                end)
            end)
        end)
    end
    _G.YOKUDO_TeleportSystem = {
        Enable = function()
            if Running then return end
            if not CollectEvent or not TARGET_UID then return end
            Running = false task.wait(0.05) StartProc()
        end,
        Disable = function() Running = false Cleanup() ResetCharacterState() end,
        SetTargetId = function(id) TARGET_UID = id end,
        SetSpeed = function(v) SPEED = math.clamp(v,50,1100) end,
        SetMethod = function(m) METHOD = (m == "InstantTeleport") and "InstantTeleport" or "TeleportFly" end,
        GetMethod = function() return METHOD end,
        GetSpeed = function() return SPEED end,
        IsEnabled = function() return Running end,
    }
end)

