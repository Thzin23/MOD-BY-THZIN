local function parseAnimationJson(json, seen)
    if not json or json == "" then return {} end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or not decoded then return {} end
    local sourceData = decoded.data or decoded
    local list = {}
    for _, item in pairs(sourceData) do
        local id = tonumber(item.id)
        if id and id > 0 and not seen[id] then
            seen[id] = true
            table.insert(list, {
                id = id,
                name = item.name or ("Animation_" .. id),
                bundledItems = item.bundledItems,
            })
        end
    end
    return list
end

local function fetchAnimations()
    if State.animationsLoading then return end
    State.animationsLoading = true

    local cacheOk = tryLoadAnimationCache()
    if cacheOk then refreshPanel() end

    task.spawn(function()
        local urls = {
            "https://raw.githubusercontent.com/7yd7/sniper-Emote/refs/heads/test/AnimationSniper.json",
            "https://raw.githubusercontent.com/7yd7/sniper-Emote/refs/heads/test/AnimationSniperoffsale.json",
        }
        local success = false
        for attempt = 1, 5 do
            local list = {}
            local seen = {}
            for _, url in ipairs(urls) do
                print("[7yd7] Baixando animações (tentativa " .. attempt .. ")...")
                local ok, json = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and json and json ~= "" then
                    local partial = parseAnimationJson(json, seen)
                    for _, item in ipairs(partial) do
                        table.insert(list, item)
                    end
                end
                task.wait(0.3)
            end
            if #list > 0 then
                if HAS_FILE_IO then
                    pcall(function()
                        writefile(State.animCacheDataPath, HttpService:JSONEncode(list))
                    end)
                end
                State.originalAnimationsData = list
                State.filteredAnimations = list
                updateTotalPages()
                print("[7yd7] ✅ Animações carregadas:", #list)
                refreshPanel()
                success = true
                break
            end
            task.wait(2)
        end
        if not success and #State.originalAnimationsData == 0 then
            print("[7yd7] ⚠️  Nenhuma animação carregada")
        end
        State.animationsLoading = false
    end)
end

