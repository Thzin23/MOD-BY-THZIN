    refreshPanel()
end)

speedBox:GetPropertyChangedSignal("Text"):Connect(function()
    speedBox.Text = speedBox.Text:gsub("[^%d%.]", "")
    local v = tonumber(speedBox.Text) or 1
    if v < 0.1 then v = 0.1 end
    State.speedValue = v
    if State.currentEmoteTrack and State.currentEmoteTrack.IsPlaying then
        pcall(function() State.currentEmoteTrack:AdjustSpeed(v) end)
    end
end)

