local function onCharacterAdded(char)
    task.wait(0.5)
    if Config.AutoReloadEnabled and getgenv().lastPlayedAnimation then
        pcall(function()
            if not player:HasAppearanceLoaded() then
                player.CharacterAppearanceLoaded:Wait()
            end
        end)
        task.wait(0.3)
        applyAnimation(getgenv().lastPlayedAnimation)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
    task.spawn(function() onCharacterAdded(player.Character) end)
end

-- ================================================================
-- APLICAR ÚLTIMA ANIMAÇÃO AO CARREGAR
-- ================================================================
task.spawn(function()
    print("[7yd7] Verificando animação salva...")
    if not Config.LastPlayedAnimationData then
        print("[7yd7] ⏭️  Nenhuma animação salva")
        return
    end
    local char = player.Character
    if not char then
        local ok, c = pcall(function()
            return player.CharacterAdded:Wait()
        end)
        if ok then char = c end
    end
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    char:WaitForChild("Animate", 10)
    pcall(function()
        if not player:HasAppearanceLoaded() then
            player.CharacterAppearanceLoaded:Wait()
        end
    end)
    task.wait(0.5)
    print("[7yd7] 🎬 Aplicando animação salva:", Config.LastPlayedAnimationData.name or Config.LastPlayedAnimationData.id)
    pcall(function()
        applyAnimation(Config.LastPlayedAnimationData)
    end)
end)

