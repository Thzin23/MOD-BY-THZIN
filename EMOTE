    else
        table.insert(State.favoriteAnimations, {
            id = animData.id,
            name = animData.name,
            bundledItems = animData.bundledItems,
        })
        State.favoriteAnimationSet[tostring(animData.id)] = true
    end
    saveFavorites()
    refreshPanel()
end

