local function stopCurrentEmote()
    if State.currentEmoteTrack then
        pcall(function() State.currentEmoteTrack:Stop() end)
        State.currentEmoteTrack = nil
    end
end

local function playEmote(emoteId)
    local humanoid = getHumanoid()
    if not humanoid then return end
    stopCurrentEmote()

    local ok, track = pcall(function()
        return humanoid:PlayEmoteAndGetAnimTrackById(tonumber(emoteId))
    end)

    if ok and track and typeof(track) == "Instance" and track:IsA("AnimationTrack") then
        State.currentEmoteTrack = track
        if State.speedEnabled then
            pcall(function() track:AdjustSpeed(State.speedValue) end)
        end
    else
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(emoteId)
        local ok2, t2 = pcall(function()
            return humanoid.Animator:LoadAnimation(anim)
        end)
        if ok2 and t2 then
            State.currentEmoteTrack = t2
            t2.Priority = Enum.AnimationPriority.Action
            t2.Looped = true
            t2:Play()
            if State.speedEnabled then
                pcall(function() t2:AdjustSpeed(State.speedValue) end)
            end
        end
    end
end

local function resolveAnimationMappings(bundledItems)
    local mappings = {}
    for _, assetIds in pairs(bundledItems) do
        for _, assetId in pairs(assetIds) do
            local ok, objects = pcall(function()
                return game:GetObjects("rbxassetid://" .. assetId)
            end)
            if ok and objects then
                local function searchTree(parent, path)
                    for _, child in pairs(parent:GetChildren()) do
                        if child:IsA("Animation") then
                            local p = path .. "." .. child.Name
                            local parts = p:split(".")
                            table.insert(mappings, {
                                category    = parts[#parts - 1],
                                name        = parts[#parts],
                                animationId = child.AnimationId,
                            })
                        elseif #child:GetChildren() > 0 then
                            searchTree(child, path .. "." .. child.Name)
                        end
                    end
                end
                for _, obj in pairs(objects) do
                    searchTree(obj, obj.Name)
                    obj.Parent = workspace
                    task.delay(1, function() if obj then pcall(function() obj:Destroy() end) end end)
                end
            end
        end
    end
    return mappings
end

local function applyAnimation(animData)
    local char = getCharacter()
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    local animate = char:FindFirstChild("Animate")
    if not animate then return end

    Config.LastPlayedAnimationData = animData
    getgenv().lastPlayedAnimation = animData
    task.spawn(saveConfig)

    local cacheKey = tostring(animData.id)
    local mappings = State.AnimationCache[cacheKey]
    if not mappings and animData.bundledItems then
        mappings = resolveAnimationMappings(animData.bundledItems)
        if #mappings > 0 then
            State.AnimationCache[cacheKey] = mappings
            task.spawn(saveAnimationCache)
        end
    end
    if not mappings or #mappings == 0 then
        print("[7yd7] Sem mappings para animação", animData.id)
        return
    end

    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
        pcall(function() track:Stop() end)
    end

    for _, m in pairs(mappings) do
        local catFolder = animate:FindFirstChild(m.category)
        if catFolder then
            for _, obj in pairs(catFolder:GetChildren()) do
                if obj:IsA("Animation") and obj.Name:lower() == m.name:lower() then
                    obj.AnimationId = m.animationId
                end
            end
        end
    end

    if humanoid.MoveDirection.Magnitude == 0 then
        animate.Disabled = true
        animate.Disabled = false
    end
end

