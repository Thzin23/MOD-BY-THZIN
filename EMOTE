local function isFav(id)
    if State.currentMode == "animation" then
        return State.favoriteAnimationSet[tostring(id)] == true
    end
    return State.favoriteEmoteSet[tostring(id)] == true
end

local function getCurrentList()
    if State.currentMode == "animation" then
        return State.filteredAnimations
    end
    return State.filteredEmotes
end

local function getPageItems()
    local list = getCurrentList()
    local startIdx = (State.currentPage - 1) * State.itemsPerPage + 1
    local items = {}
    for i = startIdx, math.min(startIdx + State.itemsPerPage - 1, #list) do
        if list[i] then table.insert(items, list[i]) end
    end
    return items
end

local function updateTotalPages()
    local list = getCurrentList()
    State.totalPages = math.max(1, math.ceil(#list / State.itemsPerPage))
    if State.currentPage > State.totalPages then
        State.currentPage = State.totalPages
    end
end

