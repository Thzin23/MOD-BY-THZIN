local function tryLoadEmoteCache()
    if not HAS_FILE_IO then return false end
    if not isfile(State.emoteCachePath) then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(State.emoteCachePath))
    end)
    if ok and type(decoded) == "table" and #decoded > 0 then
        State.originalEmotesData = decoded
        State.filteredEmotes = decoded
        updateTotalPages()
        print("[7yd7] ✅ Emotes (cache):", #decoded)
        return true
    end
    return false
end

local function parseEmoteJson(json)
    if not json or json == "" then return nil end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or not decoded then return nil end
    local sourceData = decoded.data or decoded
    local list = {}
    for _, item in pairs(sourceData) do
        local id = tonumber(item.id)
        if id and id > 0 then
            table.insert(list, {
                id = id,
                name = item.name or ("Emote_" .. id),
            })
        end
    end
    if #list > 0 then return list end
    return nil
end

local function fetchEmotes()
    if State.emotesLoading then return end
    State.emotesLoading = true

    local cacheOk = tryLoadEmoteCache()
    if cacheOk then refreshPanel() end

    task.spawn(function()
        local urls = {
            "https://raw.githubusercontent.com/7yd7/sniper-Emote/refs/heads/test/EmoteSniper.json",
            "https://raw.githubusercontent.com/7yd7/sniper-Emote/main/EmoteSniper.json",
        }
        local success = false
        for attempt = 1, 5 do
            for _, url in ipairs(urls) do
                print("[7yd7] Baixando emotes (tentativa " .. attempt .. ")...")
                local ok, json = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and json and json ~= "" then
                    local list = parseEmoteJson(json)
                    if list and #list > 0 then
                        if HAS_FILE_IO then
                            pcall(function()
                                writefile(State.emoteCachePath, HttpService:JSONEncode(list))
                            end)
                        end
                        State.originalEmotesData = list
                        State.filteredEmotes = list
                        updateTotalPages()
                        print("[7yd7] ✅ Emotes carregados:", #list)
                        refreshPanel()
                        success = true
                        break
                    end
                end
                task.wait(0.5)
            end
            if success then break end
            task.wait(2)
        end
        if not success and #State.originalEmotesData == 0 then
            print("[7yd7] ⚠️  Usando fallback de emotes")
            State.originalEmotesData = {
                {id = 3360686498, name = "Stadium"},
                {id = 3360692915, name = "Tilt"},
                {id = 3576968026, name = "Shrug"},
                {id = 3360689775, name = "Salute"},
            }
            State.filteredEmotes = State.originalEmotesData
            updateTotalPages()
            refreshPanel()
        end
        State.emotesLoading = false
    end)
end

