local function smartMatch(name, term)
    if not term or term == "" then return true end
    name = name:lower()
    term = term:lower()
    for word in term:gmatch("%S+") do
        if not name:find(word, 1, true) then return false end
    end
    return true
end

local function doSearch(term)
    term = (term or ""):lower()
    if State.currentMode == "emote" then
        if term == "" then
            State.filteredEmotes = State.originalEmotesData
        else
            local list = {}
            local isId = term:match("^%d+$")
            for _, e in pairs(State.originalEmotesData) do
                if isId and tostring(e.id) == term then
                    table.insert(list, e)
                elseif not isId and smartMatch(e.name, term) then
                    table.insert(list, e)
                end
            end
            State.filteredEmotes = list
        end
        State.emoteSearchTerm = term
    else
        if term == "" then
            State.filteredAnimations = State.originalAnimationsData
        else
            local list = {}
            local isId = term:match("^%d+$")
            for _, a in pairs(State.originalAnimationsData) do
                if isId and tostring(a.id) == term then
                    table.insert(list, a)
                elseif not isId and smartMatch(a.name, term) then
                    table.insert(list, a)
                end
            end
            State.filteredAnimations = list
        end
        State.animationSearchTerm = term
    end
    State.currentPage = 1
    updateTotalPages()
    refreshPanel()
end

