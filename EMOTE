local function toggleFavEmote(id, name)
    if isFav(id) then
        for i, f in pairs(State.favoriteEmotes) do
            if tostring(f.id) == tostring(id) then
                table.remove(State.favoriteEmotes, i)
                break
            end
        end
        State.favoriteEmoteSet[tostring(id)] = nil
    else
        table.insert(State.favoriteEmotes, {id = id, name = name})
        State.favoriteEmoteSet[tostring(id)] = true
    end
    saveFavorites()
    refreshPanel()
end

local function toggleFavAnimation(animData)
