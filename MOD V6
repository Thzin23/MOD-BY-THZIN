    knob.BorderSizePixel = 0
    knob.ZIndex = 11
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local enabled = default and true or false
    local _inCallback = false

    local function applyVisual(state)
        switch.BackgroundColor3 = state and onColor or offColor
        knob.Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        knob.BackgroundColor3 = state and T.Background or T.SubText
    end

    applyVisual(enabled)

    local function SetState(state, fireCallback)
        state = not not state
        enabled = state
        applyVisual(state)
        if fireCallback and callback and not _inCallback then
            _inCallback = true
            local ok, err = pcall(callback, state)
            _inCallback = false
            if not ok then
                warn("[MANOX Toggle] Erro no callback:", err)
            end
        end
    end

    switch.MouseButton1Click:Connect(function()
        if _inCallback then return end
        SetState(not enabled, true)
    end)

    return card, { SetState = SetState, GetState = function() return enabled end, Button = switch }
end

function UI.Slider(parent, order, title, min, max, default, callback, decimals)
    local card = MakeCard(parent, order, 62)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -32, 0, 20)
