local function GetClosestPlayerForAim()
    local closestPlayer = nil
    local closestDistance = Opcoes.aimFOV
    pcall(function()
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local targetPart = player.Character:FindFirstChild(Opcoes.aimPart)
                if targetPart and humanoid and humanoid.Health > 0 then
                    local screenPosition, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - screenCenter).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end)
    return closestPlayer
end

local function AimAtPlayer(player)
    pcall(function()
        if not player or not player.Character then return end
        local targetPart = player.Character:FindFirstChild(Opcoes.aimPart)
        if not targetPart then return end
        local targetPosition = targetPart.Position
        local cameraPosition = Camera.CFrame.Position
        local direction = (targetPosition - cameraPosition).Unit
        local newCFrame = CFrame.new(cameraPosition, cameraPosition + direction)
        if Opcoes.aimSmoothness > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, math.clamp(Opcoes.aimSmoothness, 0.01, 1))
        else
            Camera.CFrame = newCFrame
        end
    end)
end

local function CreateFOV()
    if not HAS_DRAWING then return end
    local ok, circle = pcall(function() return Drawing.new("Circle") end)
    if not ok or not circle then return end
    fovCircle = circle
    fovCircle.Visible = false
    fovCircle.Color = Opcoes.fovColor
    fovCircle.Thickness = Opcoes.fovThickness
    fovCircle.Transparency = 1
    fovCircle.Radius = Opcoes.aimFOV
    fovCircle.Filled = false
    fovCircle.NumSides = 64
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local connFov = RunService.RenderStepped:Connect(function()
        pcall(function()
            if fovCircle then
                fovCircle.Visible = Opcoes.showFOV and Opcoes.aimbotEnabled
                fovCircle.Radius = Opcoes.aimFOV
                fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            end
        end)
    end)
    table.insert(ConexoesExecucao, connFov)
end

