local function CreateFloatBall()
    if not ScreenGuiGlobal then return end
    local Ball = Instance.new("TextButton")
    Ball.Name = "ManoxBall"
    Ball.Size = UDim2.new(0, 56, 0, 56)
    Ball.Position = UDim2.new(0.05, 0, 0.4, 0)
    Ball.BackgroundColor3 = T.SurfaceHi
    Ball.Text = "M"
    Ball.TextColor3 = T.Primary
    Ball.Font = Enum.Font.GothamBold
    Ball.TextSize = 22
    Ball.Visible = false
    Ball.Parent = ScreenGuiGlobal
    Instance.new("UICorner", Ball).CornerRadius = UDim.new(1, 0)
    local bs = Instance.new("UIStroke", Ball)
    bs.Color = T.Primary bs.Thickness = 2 bs.Transparency = 0.2

    UI.MakeDraggable(Ball, Ball)
    local MainFrame = ScreenGuiGlobal:FindFirstChild("MainFrame")

    Ball.MouseButton1Click:Connect(function()
        Ball.Visible = false
        if MainFrame then MainFrame.Visible = true end
    end)

    if MainFrame then
        local topBar = MainFrame:FindFirstChild("TopBar")
        if topBar then
            for _, b in ipairs(topBar:GetChildren()) do
                if b:IsA("TextButton") and b.Text == "—" then
                    b.MouseButton1Click:Connect(function()
                        MainFrame.Visible = false
                        Ball.Visible = true
                    end)
                end
            end
        end
    end
    return Ball
end

