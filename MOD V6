local HAS_DRAWING = (function()
    local ok = pcall(function() return Drawing.new("Line") end)
    return ok
end)()

local function safeNew(kind)
    if not HAS_DRAWING then return nil end
    local ok, d = pcall(Drawing.new, kind)
    if ok then return d end
    return nil
end

local function CreateESP(player)
    if player == LocalPlayer then return false end
    if not HAS_DRAWING then return false end
    if Drawings.ESP[player] then return true end

    local box = {
        TopLeft = safeNew("Line"),
        TopRight = safeNew("Line"),
        BottomLeft = safeNew("Line"),
        BottomRight = safeNew("Line"),
        Left = safeNew("Line"),
        Right = safeNew("Line"),
        Top = safeNew("Line"),
        Bottom = safeNew("Line")
    }
    for _, l in pairs(box) do
        if l then
            l.Visible = false
            l.Color = Colors.Enemy
            l.Thickness = ESP.BoxThickness
        end
    end

    local tracer = safeNew("Line")
    if tracer then
        tracer.Visible = false
        tracer.Color = Colors.Enemy
        tracer.Thickness = ESP.TracerThickness
    end

    local healthBar = {
        Outline = safeNew("Square"),
        Fill = safeNew("Square"),
        Text = safeNew("Text")
    }
    if healthBar.Outline then healthBar.Outline.Visible = false healthBar.Outline.Filled = false end
    if healthBar.Fill then
        healthBar.Fill.Visible = false
        healthBar.Fill.Color = Colors.Health
        healthBar.Fill.Filled = true
    end
    if healthBar.Text then
        healthBar.Text.Visible = false
        healthBar.Text.Center = true
        healthBar.Text.Size = ESP.TextSize
        healthBar.Text.Color = Colors.Health
        healthBar.Text.Font = ESP.TextFont
        healthBar.Text.Outline = true
    end

    local info = {
        Name = safeNew("Text"),
        Distance = safeNew("Text")
    }
    for _, t in pairs(info) do
        if t then
            t.Visible = false
            t.Center = true
            t.Size = ESP.TextSize
            t.Color = Colors.Enemy
            t.Font = ESP.TextFont
            t.Outline = true
        end
    end

    local snapline = safeNew("Line")
    if snapline then
        snapline.Visible = false
        snapline.Color = Colors.Enemy
        snapline.Thickness = 1
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ManoxESP_Chams"
    highlight.FillColor = ESP.ChamsFillColor
    highlight.OutlineColor = ESP.ChamsOutlineColor
    highlight.FillTransparency = ESP.ChamsTransparency
    highlight.OutlineTransparency = ESP.ChamsOutlineTransparency
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    Highlights[player] = highlight

    local skeleton = {
        Head = safeNew("Line"),
        UpperSpine = safeNew("Line"),
        LeftShoulder = safeNew("Line"),
        LeftUpperArm = safeNew("Line"),
        LeftLowerArm = safeNew("Line"),
        RightShoulder = safeNew("Line"),
        RightUpperArm = safeNew("Line"),
        RightLowerArm = safeNew("Line"),
        LeftHip = safeNew("Line"),
        LeftUpperLeg = safeNew("Line"),
        LeftLowerLeg = safeNew("Line"),
        RightHip = safeNew("Line"),
        RightUpperLeg = safeNew("Line"),
        RightLowerLeg = safeNew("Line")
    }
    for _, l in pairs(skeleton) do
        if l then
            l.Visible = false
            l.Color = ESP.SkeletonColor
            l.Thickness = ESP.SkeletonThickness
            l.Transparency = ESP.SkeletonTransparency
        end
    end
    Drawings.Skeleton[player] = skeleton

    Drawings.ESP[player] = {
        Box = box,
        Tracer = tracer,
        HealthBar = healthBar,
        Info = info,
        Snapline = snapline
    }
    return true
end

local function RemoveESP(player)
    local esp = Drawings.ESP[player]
    if esp then
        for _, obj in pairs(esp.Box) do
            if obj then pcall(function() obj:Remove() end) end
        end
        if esp.Tracer then pcall(function() esp.Tracer:Remove() end) end
        for _, obj in pairs(esp.HealthBar) do
            if obj then pcall(function() obj:Remove() end) end
        end
        for _, obj in pairs(esp.Info) do
            if obj then pcall(function() obj:Remove() end) end
        end
        if esp.Snapline then pcall(function() esp.Snapline:Remove() end) end
        Drawings.ESP[player] = nil
    end
    local h = Highlights[player]
    if h then
        pcall(function() h:Destroy() end)
        Highlights[player] = nil
    end
    local sk = Drawings.Skeleton[player]
    if sk then
        for _, line in pairs(sk) do
            if line then pcall(function() line:Remove() end) end
        end
        Drawings.Skeleton[player] = nil
    end
end

local function GetPlayerColor(player)
    if ESP.RainbowEnabled then return Colors.Rainbow end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return Colors.Ally
    end
    return Colors.Enemy
end

local function GetTracerOrigin()
    local o = ESP.TracerOrigin
    if o == "Bottom" then
        return Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
    elseif o == "Top" then
        return Vector2.new(Camera.ViewportSize.X/2, 0)
    elseif o == "Mouse" then
        return Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
    else
        return Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    end
end

local function HideAllESP(esp, player)
    for _, obj in pairs(esp.Box) do if obj then obj.Visible = false end end
    if esp.Tracer then esp.Tracer.Visible = false end
    for _, obj in pairs(esp.HealthBar) do if obj then obj.Visible = false end end
    for _, obj in pairs(esp.Info) do if obj then obj.Visible = false end end
    if esp.Snapline then esp.Snapline.Visible = false end
    local sk = Drawings.Skeleton[player]
    if sk then for _, l in pairs(sk) do if l then l.Visible = false end end end
end

local function UpdateESP(player)
    if not ESP.Enabled then return end
    local esp = Drawings.ESP[player]
    if not esp then return end

    local character = player.Character
    if not character then HideAllESP(esp, player) return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then HideAllESP(esp, player) return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then HideAllESP(esp, player) return end

    local pos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
    if not onScreen then HideAllESP(esp, player) return end

    local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
    if distance > ESP.MaxDistance then HideAllESP(esp, player) return end

    if ESP.TeamCheck and not ESP.ShowTeam then
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
            HideAllESP(esp, player)
            return
        end
    end

    local color = GetPlayerColor(player)
    local size = character:GetExtentsSize()
    local cf = rootPart.CFrame

    local top = Camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y/2, 0)).Position)
    local bottom = Camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y/2, 0)).Position)

    local screenSize = bottom.Y - top.Y
    local boxWidth = screenSize * 0.65
    local boxPosition = Vector2.new(top.X - boxWidth/2, top.Y)
    local boxSize = Vector2.new(boxWidth, screenSize)

    for _, obj in pairs(esp.Box) do if obj then obj.Visible = false end end
    if ESP.BoxESP then
        if ESP.BoxStyle == "Corner" then
            local c = boxWidth * 0.2
            local bl = boxPosition + Vector2.new(0, boxSize.Y)
            local br = boxPosition + Vector2.new(boxSize.X, boxSize.Y)
            local tr = boxPosition + Vector2.new(boxSize.X, 0)
            local tl = boxPosition
            if esp.Box.TopLeft then esp.Box.TopLeft.From = tl esp.Box.TopLeft.To = tl + Vector2.new(c,0) esp.Box.TopLeft.Visible = true esp.Box.TopLeft.Color = color esp.Box.TopLeft.Thickness = ESP.BoxThickness end
            if esp.Box.TopRight then esp.Box.TopRight.From = tr esp.Box.TopRight.To = tr - Vector2.new(c,0) esp.Box.TopRight.Visible = true esp.Box.TopRight.Color = color esp.Box.TopRight.Thickness = ESP.BoxThickness end
            if esp.Box.BottomLeft then esp.Box.BottomLeft.From = bl esp.Box.BottomLeft.To = bl + Vector2.new(c,0) esp.Box.BottomLeft.Visible = true esp.Box.BottomLeft.Color = color esp.Box.BottomLeft.Thickness = ESP.BoxThickness end
            if esp.Box.BottomRight then esp.Box.BottomRight.From = br esp.Box.BottomRight.To = br - Vector2.new(c,0) esp.Box.BottomRight.Visible = true esp.Box.BottomRight.Color = color esp.Box.BottomRight.Thickness = ESP.BoxThickness end
            if esp.Box.Left then esp.Box.Left.From = tl esp.Box.Left.To = tl + Vector2.new(0,c) esp.Box.Left.Visible = true esp.Box.Left.Color = color esp.Box.Left.Thickness = ESP.BoxThickness end
            if esp.Box.Right then esp.Box.Right.From = tr esp.Box.Right.To = tr + Vector2.new(0,c) esp.Box.Right.Visible = true esp.Box.Right.Color = color esp.Box.Right.Thickness = ESP.BoxThickness end
            if esp.Box.Top then esp.Box.Top.From = bl esp.Box.Top.To = bl - Vector2.new(0,c) esp.Box.Top.Visible = true esp.Box.Top.Color = color esp.Box.Top.Thickness = ESP.BoxThickness end
            if esp.Box.Bottom then esp.Box.Bottom.From = br esp.Box.Bottom.To = br - Vector2.new(0,c) esp.Box.Bottom.Visible = true esp.Box.Bottom.Color = color esp.Box.Bottom.Thickness = ESP.BoxThickness end
        elseif ESP.BoxStyle == "Full" then
            if esp.Box.Left then esp.Box.Left.From = boxPosition esp.Box.Left.To = boxPosition + Vector2.new(0, boxSize.Y) esp.Box.Left.Visible = true esp.Box.Left.Color = color esp.Box.Left.Thickness = ESP.BoxThickness end
            if esp.Box.Right then esp.Box.Right.From = boxPosition + Vector2.new(boxSize.X, 0) esp.Box.Right.To = boxPosition + Vector2.new(boxSize.X, boxSize.Y) esp.Box.Right.Visible = true esp.Box.Right.Color = color esp.Box.Right.Thickness = ESP.BoxThickness end
            if esp.Box.Top then esp.Box.Top.From = boxPosition esp.Box.Top.To = boxPosition + Vector2.new(boxSize.X, 0) esp.Box.Top.Visible = true esp.Box.Top.Color = color esp.Box.Top.Thickness = ESP.BoxThickness end
            if esp.Box.Bottom then esp.Box.Bottom.From = boxPosition + Vector2.new(0, boxSize.Y) esp.Box.Bottom.To = boxPosition + Vector2.new(boxSize.X, boxSize.Y) esp.Box.Bottom.Visible = true esp.Box.Bottom.Color = color esp.Box.Bottom.Thickness = ESP.BoxThickness end
        elseif ESP.BoxStyle == "ThreeD" then
            local function w2s(v3) local sp, on = Camera:WorldToViewportPoint(v3) if on then return Vector2.new(sp.X, sp.Y) end return nil end
            local fTL = w2s((cf * CFrame.new(-size.X/2, size.Y/2, -size.Z/2)).Position)
            local fTR = w2s((cf * CFrame.new(size.X/2, size.Y/2, -size.Z/2)).Position)
            local fBL = w2s((cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2)).Position)
            local fBR = w2s((cf * CFrame.new(size.X/2, -size.Y/2, -size.Z/2)).Position)
            local bTL = w2s((cf * CFrame.new(-size.X/2, size.Y/2, size.Z/2)).Position)
            local bTR = w2s((cf * CFrame.new(size.X/2, size.Y/2, size.Z/2)).Position)
            local bBL = w2s((cf * CFrame.new(-size.X/2, -size.Y/2, size.Z/2)).Position)
            local bBR = w2s((cf * CFrame.new(size.X/2, -size.Y/2, size.Z/2)).Position)
            if fTL and fTR and fBL and fBR and bTL and bTR and bBL and bBR then
                local function setLine(l, a, b)
                    if l then l.From = a l.To = b l.Visible = true l.Color = color l.Thickness = ESP.BoxThickness end
                end
                setLine(esp.Box.TopLeft, fTL, fTR)
                setLine(esp.Box.TopRight, fTR, fBR)
                setLine(esp.Box.BottomLeft, fBL, fBR)
                setLine(esp.Box.BottomRight, fTL, fBL)
                setLine(esp.Box.Left, bTL, bTR)
                setLine(esp.Box.Right, bTR, bBR)
                setLine(esp.Box.Top, bBL, bBR)
                setLine(esp.Box.Bottom, bTL, bBL)
            end
        end
    end

    if esp.Tracer then
        if ESP.TracerESP then
            esp.Tracer.From = GetTracerOrigin()
            esp.Tracer.To = Vector2.new(pos.X, pos.Y)
            esp.Tracer.Color = color
            esp.Tracer.Thickness = ESP.TracerThickness
            esp.Tracer.Visible = true
        else
            esp.Tracer.Visible = false
        end
    end

    if ESP.HealthESP then
        local hp = humanoid.Health
        local maxHp = humanoid.MaxHealth
        local pct = math.clamp(hp / math.max(maxHp, 1), 0, 1)
        local barH = screenSize * 0.9
        local barW = 3
        local barPos = Vector2.new(boxPosition.X - barW - 3, boxPosition.Y + (screenSize - barH)/2)

        if esp.HealthBar.Outline then
            esp.HealthBar.Outline.Size = Vector2.new(barW, barH)
            esp.HealthBar.Outline.Position = barPos
            esp.HealthBar.Outline.Color = Color3.fromRGB(0, 0, 0)
            esp.HealthBar.Outline.Visible = true
        end
        if esp.HealthBar.Fill then
            esp.HealthBar.Fill.Size = Vector2.new(barW - 2, barH * pct)
            esp.HealthBar.Fill.Position = Vector2.new(barPos.X + 1, barPos.Y + barH * (1 - pct))
            esp.HealthBar.Fill.Color = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 0)
            esp.HealthBar.Fill.Visible = true
        end
        if ESP.HealthStyle == "Both" or ESP.HealthStyle == "Text" then
            if esp.HealthBar.Text then
                esp.HealthBar.Text.Text = string.format("%d %s", math.floor(hp), ESP.HealthTextSuffix)
                esp.HealthBar.Text.Position = Vector2.new(barPos.X + barW + 4, barPos.Y + barH/2)
                esp.HealthBar.Text.Color = color
                esp.HealthBar.Text.Size = ESP.TextSize
                esp.HealthBar.Text.Visible = true
            end
        else
            if esp.HealthBar.Text then esp.HealthBar.Text.Visible = false end
        end
    else
        for _, obj in pairs(esp.HealthBar) do if obj then obj.Visible = false end end
    end

    if esp.Info.Name then
        if ESP.NameESP then
            esp.Info.Name.Text = player.DisplayName
            esp.Info.Name.Position = Vector2.new(boxPosition.X + boxWidth/2, boxPosition.Y - 18)
            esp.Info.Name.Color = color
            esp.Info.Name.Size = ESP.TextSize
            esp.Info.Name.Visible = true
        else
            esp.Info.Name.Visible = false
        end
    end

    if esp.Info.Distance then
        if ESP.ShowDistance then
            esp.Info.Distance.Text = string.format("%d %s", math.floor(distance), ESP.DistanceUnit)
            esp.Info.Distance.Position = Vector2.new(boxPosition.X + boxWidth/2, boxPosition.Y + boxSize.Y + 4)
            esp.Info.Distance.Color = Colors.Distance
            esp.Info.Distance.Size = math.max(ESP.TextSize - 3, 10)
            esp.Info.Distance.Visible = true
        else
            esp.Info.Distance.Visible = false
        end
    end

    if esp.Snapline then
        if ESP.Snaplines then
            esp.Snapline.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            esp.Snapline.To = Vector2.new(pos.X, pos.Y)
            esp.Snapline.Color = color
            esp.Snapline.Visible = true
        else
            esp.Snapline.Visible = false
        end
    end

    local highlight = Highlights[player]
    if highlight then
        if ESP.ChamsEnabled then
            if highlight.Parent ~= character then highlight.Parent = character end
            highlight.FillColor = ESP.ChamsFillColor
            highlight.OutlineColor = ESP.ChamsOutlineColor
            highlight.FillTransparency = ESP.ChamsTransparency
            highlight.OutlineTransparency = ESP.ChamsOutlineTransparency
            highlight.Enabled = true
        else
            highlight.Enabled = false
        end
    end

    local skeleton = Drawings.Skeleton[player]
    if skeleton then
        if ESP.SkeletonESP then
            local function bone(a, b, line)
                if not a or not b or not line then if line then line.Visible = false end return end
                local aS, aOn = Camera:WorldToViewportPoint(a.Position)
                local bS, bOn = Camera:WorldToViewportPoint(b.Position)
                if aOn and bOn and aS.Z > 0 and bS.Z > 0 then
                    line.From = Vector2.new(aS.X, aS.Y)
                    line.To = Vector2.new(bS.X, bS.Y)
                    line.Color = ESP.SkeletonColor
                    line.Thickness = ESP.SkeletonThickness
                    line.Transparency = ESP.SkeletonTransparency
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
            local Head = character:FindFirstChild("Head")
            local UpperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            local LowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
            local LUA = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
            local LLA = character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("Left Arm")
            local LH  = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
            local RUA = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
            local RLA = character:FindFirstChild("RightLowerArm") or character:FindFirstChild("Right Arm")
            local RH  = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
            local LUL = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
            local LLL = character:FindFirstChild("LeftLowerLeg") or character:FindFirstChild("Left Leg")
            local LF  = character:FindFirstChild("LeftFoot") or character:FindFirstChild("Left Leg")
            local RUL = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
            local RLL = character:FindFirstChild("RightLowerLeg") or character:FindFirstChild("Right Leg")
            local RF  = character:FindFirstChild("RightFoot") or character:FindFirstChild("Right Leg")

            bone(Head, UpperTorso, skeleton.Head)
            bone(UpperTorso, LowerTorso, skeleton.UpperSpine)
            bone(UpperTorso, LUA, skeleton.LeftShoulder)
            bone(LUA, LLA, skeleton.LeftUpperArm)
            bone(LLA, LH, skeleton.LeftLowerArm)
            bone(UpperTorso, RUA, skeleton.RightShoulder)
            bone(RUA, RLA, skeleton.RightUpperArm)
            bone(RLA, RH, skeleton.RightLowerArm)
            bone(LowerTorso, LUL, skeleton.LeftHip)
            bone(LUL, LLL, skeleton.LeftUpperLeg)
            bone(LLL, LF, skeleton.LeftLowerLeg)
            bone(LowerTorso, RUL, skeleton.RightHip)
            bone(RUL, RLL, skeleton.RightUpperLeg)
            bone(RLL, RF, skeleton.RightLowerLeg)
        else
            for _, line in pairs(skeleton) do if line then line.Visible = false end end
        end
    end
end

